# GitHub API Personal Access Token (PAT) for org resolution and members check
GITHUB_TOKEN=your_github_token_here

# GitLab Access Token (optional, for GitLab integration/verification)
GITLAB_ACCESS_TOKEN=your_gitlab_token_here

# Public repository URL for Remotika
NEXT_PUBLIC_GITHUB_REPO=https://github.com/hryagstn/remotika

# Telegram bot and channel configuration for pipeline notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL_ID=your_telegram_channel_id_here
